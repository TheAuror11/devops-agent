# Runtime
APP_ENV=local
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8080
API_CORS_ORIGINS=http://localhost:5173,http://localhost:8080
API_KEYS=dev-local-key

# AWS
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=000000000000

# Amazon Bedrock (leave empty to use the local reasoner)
BEDROCK_MODEL_ID=
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
BEDROCK_REGION=us-east-1
BEDROCK_MAX_TOKENS=4096
BEDROCK_TEMPERATURE=0.1
BEDROCK_MAX_TOOL_ROUNDS=12

# Persistence (local | dynamodb)
STORE_BACKEND=local
DATA_DIR=./data

# Queue (local | sqs)
QUEUE_BACKEND=local
SQS_INVESTIGATION_QUEUE_URL=
SQS_DLQ_URL=
SQS_WAIT_TIME_SECONDS=20
WORKER_CONCURRENCY=4

# DynamoDB table names (prod)
DDB_TABLE_PREFIX=devops-agent

# OpenSearch (optional RAG backend)
OPENSEARCH_ENDPOINT=
OPENSEARCH_INDEX=devops-agent-runbooks

# Resilience
IDEMPOTENCY_TTL_SECONDS=86400
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RESET_SECONDS=30

# Auth
JWT_SECRET=change-me-in-production
JWT_ISSUER=devops-agent

# Demo
SEED_DEMO_DATA=true
