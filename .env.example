# Runtime
APP_ENV=local
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8080
API_CORS_ORIGINS=http://localhost:5173,http://localhost:8080
API_KEYS=dev-local-key

# AWS
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=000000000000

# Amazon Bedrock (leave empty to use the local reasoner)
BEDROCK_MODEL_ID=
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
BEDROCK_REGION=us-east-1
BEDROCK_MAX_TOKENS=4096
BEDROCK_TEMPERATURE=0.1
BEDROCK_MAX_TOOL_ROUNDS=12
BEDROCK_MAX_INFLIGHT_PER_TASK=2
BEDROCK_SLOT_TIMEOUT_SECONDS=120
BEDROCK_MAX_RETRIES=4

# Persistence (local | dynamodb)
STORE_BACKEND=local
DATA_DIR=./data

# Queue (local | sqs)
QUEUE_BACKEND=local
SQS_INVESTIGATION_QUEUE_URL=
SQS_DLQ_URL=
SQS_WAIT_TIME_SECONDS=20
SQS_IS_FIFO=false
SQS_VISIBILITY_TIMEOUT_SECONDS=900
WORKER_CONCURRENCY=4
VISIBILITY_HEARTBEAT_SECONDS=300
GRACEFUL_SHUTDOWN_SECONDS=120

# Ingress backpressure (0 disables a check)
MAX_QUEUE_DEPTH=500
MAX_QUEUE_AGE_SECONDS=900
MAX_INVESTIGATIONS_PER_MINUTE=120
TOOL_MAX_INFLIGHT_PER_TASK=8

# DynamoDB table names (prod)
DDB_TABLE_PREFIX=devops-agent

# OpenSearch (optional RAG backend)
OPENSEARCH_ENDPOINT=
OPENSEARCH_INDEX=devops-agent-runbooks

# Resilience
IDEMPOTENCY_TTL_SECONDS=86400
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RESET_SECONDS=30

# Auth
JWT_SECRET=change-me-in-production
JWT_ISSUER=devops-agent

# Demo
SEED_DEMO_DATA=true
